<Window x:Class="RosteringApplication.View.AddEmployee"
        x:Name="AddEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RosteringApplication.View"
        mc:Ignorable="d"
        Title="AddEmployee" Height="200" Width="200" ResizeMode="NoResize">
    <Grid>
        <TextBox HorizontalAlignment="Left" Margin="10,25,0,0" TextWrapping="Wrap" Text="{Binding FirstName}" VerticalAlignment="Top" Width="120"/>
        <TextBox HorizontalAlignment="Left" Margin="10,60,0,0" TextWrapping="Wrap" Text="{Binding LastName}" VerticalAlignment="Top" Width="120"/>
        <TextBox HorizontalAlignment="Left" Margin="10,95,0,0" TextWrapping="Wrap" Text="{Binding Role}" VerticalAlignment="Top" Width="120"/>
        <Button Content="Add" HorizontalAlignment="Left" Margin="10,128,0,0" Command="{Binding AddEmployee}" VerticalAlignment="Top" RenderTransformOrigin="-0.349,0.024"/>
        <Button Content="Cancel" HorizontalAlignment="Left" Margin="57,128,0,0"  Command="{Binding Cancel}" CommandParameter="{Binding ElementName=AddEmployeeWindow}" VerticalAlignment="Top" RenderTransformOrigin="-0.349,0.024"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,9,0,0" TextWrapping="Wrap" VerticalAlignment="Top"><Run Language="en-au" Text="First Name"/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Margin="10,44,0,0" TextWrapping="Wrap" VerticalAlignment="Top"><Run Language="en-au" Text="Last Name"/></TextBlock>
        <TextBlock HorizontalAlignment="Left" Margin="10,79,0,0" TextWrapping="Wrap" VerticalAlignment="Top"><Run Language="en-au" Text="Role"/></TextBlock>
    </Grid>
</Window>
